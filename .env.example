# Copy to .env.local. In production Vercel sets DATABASE_URL from the Neon integration;
# `vercel env pull .env.local` copies it here.
DATABASE_URL=postgres://postgres:postgres@localhost:5442/sla

# Only for `npm test`: a separate, disposable database. The API tests empty it first.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5442/sla_test
